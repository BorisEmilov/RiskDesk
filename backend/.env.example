# ---------- Servidor ----------
NODE_ENV=development
PORT=5080
CORS_ORIGIN=http://localhost:5173
# true: el procesador de eventos y el de IA corren dentro del proceso de la API (cómodo en desarrollo)
RUN_WORKERS=true
# true: crea el operador de demo (admin/analista/API key) al arrancar si no existe
SEED_DEMO=true

# ---------- Datos ----------
DATABASE_URL=postgresql://riskdesk:riskdesk_dev_pw@localhost:5436/riskdesk?schema=public
REDIS_URL=redis://localhost:6383

# ---------- Sesión ----------
JWT_ISSUER=riskdesk-api
JWT_AUDIENCE=riskdesk
JWT_SIGNING_KEY=dev-only-change-me-4b8e2d6f1a3c5e7b9d0f2a4c6e8b1d3f
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ---------- IA (cualquier API compatible con OpenAI) ----------
# Groq (gratis con límites): https://console.groq.com/keys
AI_ENABLED=true
AI_PROVIDER_NAME=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=20000
AI_MAX_REQUESTS_PER_MINUTE=20
AI_JSON_MODE=true
AI_TRIAGE_MIN_SEVERITY=Medium
# Secreto para seudonimizar identificadores antes de enviarlos al modelo (mínimo 16 caracteres)
AI_PSEUDONYMIZATION_SECRET=dev-only-pseudo-secret-9f8e7d6c

# ---------- Datos de demo ----------
SEED_ADMIN_EMAIL=admin@riskdesk.dev
SEED_ADMIN_PASSWORD=Demo1234!
SEED_ANALYST_EMAIL=analista@riskdesk.dev
SEED_ANALYST_PASSWORD=Analista1234!
SEED_API_KEY=rd_sk_demo000000000000000000000000000000000000000000
